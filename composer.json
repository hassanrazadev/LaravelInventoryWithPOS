{
    "name": "hassanrazadev/laravel-inventory-with-pos",
    "type": "project",
    "description": "Open-source Inventory Management System with Point of Sale (POS) built on Laravel 13.",
    "keywords": [
        "laravel",
        "inventory",
        "pos",
        "point-of-sale",
        "inventory-management",
        "rbac"
    ],
    "homepage": "https://github.com/hassanrazadev/LaravelInventoryWithPOS",
    "license": "MIT",
    "authors": [
        {
            "name": "Hassan Raza",
            "email": "info@hassanraza.net",
            "homepage": "https://hassanraza.net"
        }
    ],
    "support": {
        "issues": "https://github.com/hassanrazadev/LaravelInventoryWithPOS/issues",
        "source": "https://github.com/hassanrazadev/LaravelInventoryWithPOS"
    },
    "require": {
        "php": "^8.3",
        "ext-gd": "*",
        "guzzlehttp/guzzle": "^8.6",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "spatie/laravel-permission": "^7.0|^8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "@php artisan test",
        "lint": "./vendor/bin/pint --test",
        "format": "./vendor/bin/pint",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
